topology records-b9 : [pipeline] {
  meta {
    version: "1.0.0"
    description: "SP-6 B9: a cited hook whose matcher lacks one file-writing tool (made-up content)"
  }

  orchestrator {
    model: sonnet
    handles: [record-step]
  }

  agent maker {
    model: sonnet
    description: "Makes the draft"
  }

  action record-step {
    kind: inline
    description: "Records the approval"
  }

  flow {
    record-step -> maker
  }

  hooks {
    hook protect-records {
      on: PreToolUse
      matcher: "Write|Edit|MultiEdit"
      run: "hooks/protect-records.sh"
      type: command
    }
    hook protect-bash {
      on: PreToolUse
      matcher: "Bash"
      run: "hooks/protect-bash.sh"
      type: command
    }
  }

  records {
    record approvals {
      path: "records/approvals.jsonl"
      written-by: ["scripts/approve.py", "maker"]
      append-only: true
      guard: [protect-records, protect-bash]
    }
  }
}
