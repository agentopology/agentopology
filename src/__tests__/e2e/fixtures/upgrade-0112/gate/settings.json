{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "writer",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/simple-pipeline/scripts/gate-quality-check.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  }
}
