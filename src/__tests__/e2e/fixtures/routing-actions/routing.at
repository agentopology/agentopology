# routing.at: actions with no commands: of each kind, and decision and report
# actions that do name commands. Used by routing-actions.test.ts (in its own
# folder, so the scaffold golden, which reads fixtures/*.at, is unchanged).

topology routing : [pipeline] {

  meta {
    version: "1.0.0"
    description: "Conversational routing steps are no stubs"
  }

  orchestrator {
    model: sonnet
    handles: [pick, accept, finish, chat, pull, tag, choose-run, report-run]
  }

  action pick {
    kind: decision
    description: "The orchestrator picks the next station in conversation"
  }

  action accept {
    kind: decision
    description: "The orchestrator accepts the station's result"
  }

  action finish {
    kind: report
    description: "The orchestrator reports to the user"
  }

  action chat {
    kind: inline
    description: "The orchestrator talks it through"
  }

  action pull {
    kind: external
    source: "github-pr"
    description: "Names no command, so its script is a stub"
  }

  action tag {
    kind: git
    description: "Names no command, so its script is a stub"
  }

  action choose-run {
    kind: decision
    description: "A decision that runs real commands"
    commands: ["./tools/choose --next"]
  }

  action report-run {
    kind: report
    description: "A report that runs real commands"
    commands: ["./tools/report --weekly"]
  }

  agent writer {
    model: sonnet
    description: "Writes the draft"
    prompt { Write the draft. }
  }

  flow {
    pick -> writer
    writer -> accept
    accept -> finish
    finish -> chat
    chat -> pull
    pull -> tag
    tag -> choose-run
    choose-run -> report-run
  }

  gates {
    gate ready {
      after: writer
      before: accept
      run: "scripts/ready.sh"
    }
  }

  schedule {
    job nightly-finish {
      cron: "0 3 * * *"
      action: finish
    }
  }
}
